+        expect(itemHrids).toContain('/items/log');
+        expect(mockNavigateToMarketplace).toHaveBeenCalledWith('/items/cheese', 0);
+        expect(mockNavigateToMarketplace).toHaveBeenCalledWith('/items/log', 0);
+    });
+});
